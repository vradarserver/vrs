[Types]
Name: "custom"; Description: "Custom installation"; Flags: iscustom

[Components]
Name: "plugins";                       Description: "Plugins"
Name: "plugins\airportdatathumbnails"; Description: "Airport-Data.com Thumbnails - aircraft pictures from airport-data.com"
Name: "plugins\customcontent";         Description: "Custom Content - inject your own content into the web site"
Name: "plugins\databaseeditor";        Description: "Database Editor - edit aircraft in BaseStation.sqb from a browser"
Name: "plugins\databasewriter";        Description: "Database Writer - record flights to BaseStation.sqb"
Name: "plugins\disableaudio";          Description: "Disable Audio - switch off audio and text-to-speech"
Name: "plugins\disableupnp";           Description: "Disable UPnP - switch off UPnP port forwarding"
Name: "plugins\feedfilter";            Description: "Feed Filter - filter aircraft out of feeds"
Name: "plugins\sqlserver";             Description: "SQL Server - keep the BaseStation database in SQL Server"
Name: "plugins\tileservercache";       Description: "Tile Server Cache - cache OpenStreetMap map tiles"
Name: "plugins\vatsim";                Description: "VATSIM - add feeds of VATSIM flight simulator flights"
Name: "plugins\webadmin";              Description: "Web Admin - configure VRS from a browser"
Name: "languages";                     Description: "Language pack"
Name: "languages\chinese";             Description: "Chinese (Simplified)"
Name: "languages\french";              Description: "French"
Name: "languages\german";              Description: "German"
Name: "languages\portuguesebr";        Description: "Portuguese (Brazil)"
Name: "languages\russian";             Description: "Russian"

[Files]
; Airport-Data.com Thumbnails plugin
Source: "{#Root}\Plugin.AirportDataThumbnails\bin\{#BuildType}\VirtualRadar.Plugin.AirportDataThumbnails.dll"; DestDir: "{app}\Plugins\AirportDataThumbnails"; Components: plugins\airportdatathumbnails; Flags: ignoreversion;
Source: "{#Root}\Plugin.AirportDataThumbnails\bin\{#BuildType}\VirtualRadar.Plugin.AirportDataThumbnails.xml"; DestDir: "{app}\Plugins\AirportDataThumbnails"; Components: plugins\airportdatathumbnails; Flags: ignoreversion;
Source: "{#Root}\Plugin.AirportDataThumbnails\Web\*"; DestDir: "{app}\Plugins\AirportDataThumbnails\Web"; Excludes: "zz-norel-*"; Components: plugins\airportdatathumbnails; Flags: ignoreversion recursesubdirs;

