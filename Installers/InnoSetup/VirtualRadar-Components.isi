; Language pack
#define LANGFILE(ISOCODE, LANGCOMP, ASSEMBLY, PLUGINCOMP) \
    "Source: """ + Root + "\VirtualRadar\bin\" + Platform + "\" + BuildType + "\" + ISOCODE + "\" + ASSEMBLY + ".resources.dll""; " + \
    "DestDir: ""{app}\" + ISOCODE + """; " + \
    "Components: languages\" + LANGCOMP + (PLUGINCOMP == "" ? "" : " and plugins\" + PLUGINCOMP) + "; " + \
    "Flags: ignoreversion"

#emit LANGFILE("zh-CN", "chinese", "VirtualRadar.Localisation", "")
