[InstallDelete]
; Every bundled plugin is cleared, not just the ticked ones, so that unticked plugins are removed
Type: filesandordirs; Name: "{app}\Plugins\AirportDataThumbnails";
Type: filesandordirs; Name: "{app}\Plugins\BaseStationDatabaseWriter";
Type: filesandordirs; Name: "{app}\Plugins\CustomContent";
Type: filesandordirs; Name: "{app}\Plugins\DatabaseEditor";
Type: filesandordirs; Name: "{app}\Plugins\DisableAudio";
Type: filesandordirs; Name: "{app}\Plugins\DisableUPnP";
Type: filesandordirs; Name: "{app}\Plugins\FeedFilter";
Type: filesandordirs; Name: "{app}\Plugins\SqlServer";
Type: filesandordirs; Name: "{app}\Plugins\TileServerCache";
Type: filesandordirs; Name: "{app}\Plugins\Vatsim";
Type: filesandordirs; Name: "{app}\Plugins\WebAdmin";

[Code]
const
  OldUninstallKeyPrefix = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\';
  OldUninstallTimeoutMilliseconds = 60000;

var
  ComponentTablesLoaded:    Boolean;
  PreselectedForFolder:     String;
  OldInstallerAppNames:     TArrayOfString;
  PluginFolders:            TArrayOfString;
  PluginComponents:         TArrayOfString;
  LanguageIsoCodes:         TArrayOfString;
  LanguageComponents:       TArrayOfString;

procedure AddPlugin(Index: Integer; Folder, Component: String);
begin
  PluginFolders[Index] := Folder;
  PluginComponents[Index] := Component;
end;

procedure AddLanguage(Index: Integer; IsoCode, Component: String);
begin
  LanguageIsoCodes[Index] := IsoCode;
  LanguageComponents[Index] := Component;
end;

procedure LoadComponentTables();
begin
  if not ComponentTablesLoaded then begin
    ComponentTablesLoaded := True;

    SetArrayLength(PluginFolders, 11);
    SetArrayLength(PluginComponents, 11);
    AddPlugin(0,  'AirportDataThumbnails',     'plugins\airportdatathumbnails');
    AddPlugin(1,  'CustomContent',             'plugins\customcontent');
    AddPlugin(2,  'DatabaseEditor',            'plugins\databaseeditor');
    AddPlugin(3,  'BaseStationDatabaseWriter', 'plugins\databasewriter');
    AddPlugin(4,  'DisableAudio',              'plugins\disableaudio');
    AddPlugin(5,  'DisableUPnP',               'plugins\disableupnp');
    AddPlugin(6,  'FeedFilter',                'plugins\feedfilter');
    AddPlugin(7,  'SqlServer',                 'plugins\sqlserver');
    AddPlugin(8,  'TileServerCache',           'plugins\tileservercache');
    AddPlugin(9,  'Vatsim',                    'plugins\vatsim');
    AddPlugin(10, 'WebAdmin',                  'plugins\webadmin');

    SetArrayLength(LanguageIsoCodes, 5);
    SetArrayLength(LanguageComponents, 5);
    AddLanguage(0, 'zh-CN', 'languages\chinese');
    AddLanguage(1, 'fr-FR', 'languages\french');
    AddLanguage(2, 'de-DE', 'languages\german');
    AddLanguage(3, 'pt-BR', 'languages\portuguesebr');
    AddLanguage(4, 'ru-RU', 'languages\russian');

    SetArrayLength(OldInstallerAppNames, 12);
    OldInstallerAppNames[0]  := 'Airport Data Thumbnails VRS Plugin';
    OldInstallerAppNames[1]  := 'Custom Content VRS Plugin';
    OldInstallerAppNames[2]  := 'Database Editor VRS Plugin';
    OldInstallerAppNames[3]  := 'Database Writer VRS Plugin';
    OldInstallerAppNames[4]  := 'Disable Audio VRS Plugin';
    OldInstallerAppNames[5]  := 'Disable UPnP VRS Plugin';
    OldInstallerAppNames[6]  := 'Feed Filter VRS Plugin';
    OldInstallerAppNames[7]  := 'SQL Server VRS Plugin';
    OldInstallerAppNames[8]  := 'Tile Server Cache VRS Plugin';
    OldInstallerAppNames[9]  := 'VATSIM VRS Plugin';
    OldInstallerAppNames[10] := 'Web Admin VRS Plugin';
    OldInstallerAppNames[11] := 'Virtual Radar Language Pack';
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  appFolder: String;
  i:         Integer;
begin
  if CurPageID = wpSelectComponents then begin
    appFolder := AddBackslash(WizardDirValue());
    if CompareText(appFolder, PreselectedForFolder) <> 0 then begin
      PreselectedForFolder := appFolder;
      LoadComponentTables();

      for i := 0 to GetArrayLength(PluginFolders) - 1 do begin
        if DirExists(appFolder + 'Plugins\' + PluginFolders[i]) then begin
          WizardSelectComponents(PluginComponents[i]);
        end;
      end;

      for i := 0 to GetArrayLength(LanguageIsoCodes) - 1 do begin
        if FileExists(appFolder + LanguageIsoCodes[i] + '\VirtualRadar.Localisation.resources.dll') then begin
          WizardSelectComponents(LanguageComponents[i]);
        end;
      end;
    end;
  end;
end;

function IsOldInstallInAppFolder(RootKey: Integer; KeyName: String; var UninstallString: String): Boolean;
var
  appPath: String;
begin
  Result := False;
  if RegQueryStringValue(RootKey, KeyName, 'Inno Setup: App Path', appPath) then begin
    if CompareText(AddBackslash(appPath), AddBackslash(ExpandConstant('{app}'))) = 0 then begin
      Result := RegQueryStringValue(RootKey, KeyName, 'UninstallString', UninstallString);
    end;
  end;
end;

function RunOldUninstaller(RootKey: Integer; KeyName, UninstallString: String): Boolean;
var
  resultCode: Integer;
  waited:     Integer;
begin
  Exec(RemoveQuotes(UninstallString), '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART', '', SW_HIDE, ewWaitUntilTerminated, resultCode);

  // Inno uninstallers relaunch themselves from the temp folder and the original process exits
  // straight away, so wait for the uninstall entry to go instead
  waited := 0;
  while RegKeyExists(RootKey, KeyName) and (waited < OldUninstallTimeoutMilliseconds) do begin
    Sleep(250);
    waited := waited + 250;
  end;

  Result := not RegKeyExists(RootKey, KeyName);
end;

function UninstallOldInstaller(AppName: String): String;
var
  keyName:         String;
  uninstallString: String;
  removed:         Boolean;
begin
  Result := '';
  removed := True;
  keyName := OldUninstallKeyPrefix + AppName + '_is1';

  if IsOldInstallInAppFolder(HKLM32, keyName, uninstallString) then begin
    removed := RunOldUninstaller(HKLM32, keyName, uninstallString);
  end else begin
    if IsOldInstallInAppFolder(HKCU, keyName, uninstallString) then begin
      removed := RunOldUninstaller(HKCU, keyName, uninstallString);
    end;
  end;

  if not removed then begin
    Result := 'Setup could not remove the separately installed ' + AppName + '. Please uninstall it from Programs and Features and then run this installer again.';
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  i: Integer;
begin
  Result := '';
  LoadComponentTables();

  for i := 0 to GetArrayLength(OldInstallerAppNames) - 1 do begin
    if Result = '' then begin
      Result := UninstallOldInstaller(OldInstallerAppNames[i]);
    end;
  end;
end;
